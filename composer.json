{
  "name": "overtrue/laravel-package",
  "description": "Laravel package template",
  "license": "MIT",
  "authors": [
    {
      "name": "overtrue",
      "email": "anzhengchao@gmail.com"
    }
  ],
  "require": {
    "php": "^8.4",
    "laravel/framework": "^13.30"
  },
  "autoload": {
    "psr-4": {
      "Overtrue\\LaravelPackage\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests"
    }
  },
  "require-dev": {
    "mockery/mockery": "^1.6",
    "phpunit/phpunit": "^12.5.22",
    "orchestra/testbench": "^11.0",
    "vimeo/psalm": "^6.0",
    "jetbrains/phpstorm-attributes": "^1.0",
    "laravel/pint": "^1.24",
    "phpstan/phpstan": "^2.0"
  },
  "extra": {
    "laravel": {
      "providers": [
        "\\Overtrue\\LaravelPackage\\PackageServiceProvider"
      ]
    }
  },
  "scripts": {
    "post-merge": "composer install",
    "check-style": "vendor/bin/pint --test",
    "fix-style": "vendor/bin/pint",
    "test": "phpunit --colors",
    "phpstan": "phpstan analyse",
    "psalm": "psalm --show-info=true --no-cache",
    "psalm-fix": "psalm --no-cache --alter --issues=MissingReturnType,MissingParamType",
    "test-smoke": "@php tests/smoke.php"
  },
  "scripts-descriptions": {
    "test": "Run all tests.",
    "check-style": "Run style checks (only dry run - no fixing!).",
    "fix-style": "Run style checks and fix violations.",
    "test-smoke": "Test a renamed package in a fresh Laravel application."
  },
  "config": {
    "allow-plugins": {
      "composer/package-versions-deprecated": true
    }
  }
}
